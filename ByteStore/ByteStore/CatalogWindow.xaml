<Window x:Class="ByteStore.CatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ByteStore — Каталог"
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#1A1D23"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Каталог товаров"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#00FF88"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock x:Name="txtUserInfo"
                           Foreground="#00FF88"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Cursor="Hand"
                           TextDecorations="Underline"
                           Margin="0,0,15,0"
                           MouseLeftButtonUp="txtUserInfo_MouseLeftButtonUp"
                           ToolTip="Открыть профиль"/>

                <Button x:Name="btnChat"
                        Content="ЧАТ"
                        Width="80" Height="30"
                        FontSize="12" FontWeight="Bold"
                        Foreground="#00FF88"
                        Background="Transparent"
                        BorderBrush="#00FF88"
                        BorderThickness="1"
                        Cursor="Hand"
                        Margin="0,0,10,0"
                        Click="btnChat_Click"/>

                <Button x:Name="btnLogout"
                        Content="ВЫЙТИ"
                        Width="80" Height="30"
                        FontSize="12" FontWeight="Bold"
                        Foreground="#FF4A6E"
                        Background="Transparent"
                        BorderBrush="#FF4A6E"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="btnLogout_Click"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,20,0,15">

            <Button x:Name="btnRefresh"
                    Content="ОБНОВИТЬ"
                    Width="120" Height="35"
                    FontSize="12" FontWeight="Bold"
                    Foreground="#00FF88"
                    Background="Transparent"
                    BorderBrush="#00FF88"
                    BorderThickness="2"
                    Cursor="Hand"
                    Margin="0,0,10,0"
                    Click="btnRefresh_Click"/>

            <Button x:Name="btnAdd"
                    Content="ДОБАВИТЬ"
                    Width="120" Height="35"
                    FontSize="12" FontWeight="Bold"
                    Foreground="#1A1D23"
                    Background="#00FF88"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,10,0"
                    Visibility="Collapsed"
                    Click="btnAdd_Click"/>

            <Button x:Name="btnEdit"
                    Content="РЕДАКТИРОВАТЬ"
                    Width="140" Height="35"
                    FontSize="12" FontWeight="Bold"
                    Foreground="#00FF88"
                    Background="Transparent"
                    BorderBrush="#00FF88"
                    BorderThickness="2"
                    Cursor="Hand"
                    Margin="0,0,10,0"
                    Visibility="Collapsed"
                    Click="btnEdit_Click"/>

            <Button x:Name="btnDelete"
                    Content="УДАЛИТЬ"
                    Width="120" Height="35"
                    FontSize="12" FontWeight="Bold"
                    Foreground="#FF4A6E"
                    Background="Transparent"
                    BorderBrush="#FF4A6E"
                    BorderThickness="2"
                    Cursor="Hand"
                    Visibility="Collapsed"
                    Click="btnDelete_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="2"
                  x:Name="dgProducts"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  MouseDoubleClick="dgProducts_MouseDoubleClick"
                  Background="#252A33"
                  Foreground="#FFFFFF"
                  RowBackground="#252A33"
                  AlternatingRowBackground="#2F3540"
                  BorderBrush="#2F3540"
                  BorderThickness="1"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#1A1D23"
                  HeadersVisibility="Column"
                  FontSize="13"
                  RowHeight="30">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#1A1D23"/>
                    <Setter Property="Foreground" Value="#00FF88"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="BorderBrush" Value="#2F3540"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"       Binding="{Binding Id}"       Width="50"/>
                <DataGridTextColumn Header="Артикул"  Binding="{Binding Article}"  Width="100"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}"     Width="*"/>
                <DataGridTextColumn Header="Цена"     Binding="{Binding SalePrice, StringFormat={}{0:N2} ₽}" Width="100"/>
                <DataGridTextColumn Header="Остаток"  Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Цвет"     Binding="{Binding Color}"    Width="100"/>
                <DataGridTextColumn Header="Гарантия" Binding="{Binding WarrantyMonths, StringFormat={}{0} мес.}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="btnPrevPage"
                    Content="◀ НАЗАД"
                    Width="100" Height="30"
                    FontSize="12" FontWeight="Bold"
                    Click="btnPrevPage_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Foreground" Value="#00FF88"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="#00FF88"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="0">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#1A1D23"/>
                                            <Setter TargetName="border" Property="BorderBrush" Value="#333333"/>
                                            <Setter Property="Foreground" Value="#555555"/>
                                            <Setter Property="Cursor" Value="Arrow"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <TextBlock Grid.Column="1"
                       x:Name="txtPageInfo"
                       Foreground="#FFFFFF"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Margin="15,0,15,0"
                       Text="Страница 1 из 1"/>

            <TextBlock Grid.Column="2"
                       x:Name="txtRangeInfo"
                       Foreground="#A0A8B8"
                       FontSize="12"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"/>

            <Button Grid.Column="3"
                    x:Name="btnNextPage"
                    Content="ВПЕРЁД ▶"
                    Width="100" Height="30"
                    FontSize="12" FontWeight="Bold"
                    Click="btnNextPage_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Foreground" Value="#00FF88"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="#00FF88"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="0">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#1A1D23"/>
                                            <Setter TargetName="border" Property="BorderBrush" Value="#333333"/>
                                            <Setter Property="Foreground" Value="#555555"/>
                                            <Setter Property="Cursor" Value="Arrow"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <TextBlock Grid.Row="4"
                   x:Name="txtMessage"
                   Foreground="#A0A8B8"
                   FontSize="12"
                   Margin="0,10,0,0"/>
    </Grid>
</Window>