<Window x:Class="ByteStore.ProductProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ByteStore — Карточка товара"
        Height="700" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1A1D23"
        FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       x:Name="txtTitle"
                       Text="Карточка товара"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#00FF88"
                       Margin="0,0,0,20"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,25,0">
                    <Border Width="200" Height="200"
                            Background="#252A33"
                            CornerRadius="10"
                            BorderBrush="#00FF88"
                            BorderThickness="2"
                            ClipToBounds="True">
                        <Image x:Name="imgPhoto" Stretch="UniformToFill"/>
                    </Border>

                    <Button x:Name="btnUploadPhoto"
                            Content="ЗАГРУЗИТЬ ФОТО"
                            Height="32"
                            FontSize="11" FontWeight="Bold"
                            Foreground="#00FF88"
                            Background="Transparent"
                            BorderBrush="#00FF88"
                            BorderThickness="2"
                            Cursor="Hand"
                            Margin="0,10,0,0"
                            Click="btnUploadPhoto_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Top">

                    <TextBlock x:Name="txtName"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="txtArticle"
                               FontSize="14"
                               Foreground="#A0A8B8"
                               Margin="0,8,0,0"/>

                    <TextBlock x:Name="txtCategory"
                               FontSize="14"
                               Foreground="#A0A8B8"
                               Margin="0,4,0,0"/>

                    <TextBlock x:Name="txtManufacturer"
                               FontSize="14"
                               Foreground="#A0A8B8"
                               Margin="0,4,0,0"/>

                    <TextBlock x:Name="txtSupplier"
                               FontSize="14"
                               Foreground="#A0A8B8"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Height="1" Background="#2F3540"
                    Margin="0,25,0,20"/>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Цена закупки" Foreground="#A0A8B8" FontSize="12"/>
                    <TextBlock x:Name="txtPurchasePrice" FontSize="16" FontWeight="Bold"
                               Foreground="#FFFFFF" Margin="0,3,0,12"/>

                    <TextBlock Text="Остаток на складе" Foreground="#A0A8B8" FontSize="12"/>
                    <TextBlock x:Name="txtQuantity" FontSize="16" FontWeight="Bold"
                               Foreground="#FFFFFF" Margin="0,3,0,12"/>

                    <TextBlock Text="Гарантия" Foreground="#A0A8B8" FontSize="12"/>
                    <TextBlock x:Name="txtWarranty" FontSize="16" FontWeight="Bold"
                               Foreground="#FFFFFF" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Цена продажи" Foreground="#A0A8B8" FontSize="12"/>
                    <TextBlock x:Name="txtSalePrice" FontSize="16" FontWeight="Bold"
                               Foreground="#00FF88" Margin="0,3,0,12"/>

                    <TextBlock Text="Цвет" Foreground="#A0A8B8" FontSize="12"/>
                    <TextBlock x:Name="txtColor" FontSize="16" FontWeight="Bold"
                               Foreground="#FFFFFF" Margin="0,3,0,12"/>

                    <TextBlock Text="Дата добавления" Foreground="#A0A8B8" FontSize="12"/>
                    <TextBlock x:Name="txtCreatedAt" FontSize="14" FontWeight="Bold"
                               Foreground="#FFFFFF" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="4"
                    Height="1" Background="#2F3540"
                    Margin="0,25,0,20"/>

            <StackPanel Grid.Row="5">
                <TextBlock Text="Описание" Foreground="#00FF88" FontSize="14" FontWeight="Bold"
                           Margin="0,0,0,8"/>
                <TextBlock x:Name="txtDescription"
                           FontSize="13"
                           Foreground="#FFFFFF"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="6"
                    Height="1" Background="#2F3540"
                    Margin="0,25,0,20"/>

            <Grid Grid.Row="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#252A33"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Продано" Foreground="#A0A8B8" FontSize="11"/>
                        <TextBlock x:Name="txtTotalSold" Text="—"
                                   Foreground="#00FF88" FontSize="22" FontWeight="Bold"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="#252A33"
                        CornerRadius="8"
                        Padding="15"
                        Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Выручка" Foreground="#A0A8B8" FontSize="11"/>
                        <TextBlock x:Name="txtTotalRevenue" Text="—"
                                   Foreground="#00FF88" FontSize="22" FontWeight="Bold"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="#252A33"
                        CornerRadius="8"
                        Padding="15"
                        Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Заказов" Foreground="#A0A8B8" FontSize="11"/>
                        <TextBlock x:Name="txtOrderCount" Text="—"
                                   Foreground="#00FF88" FontSize="22" FontWeight="Bold"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="8" Margin="0,20,0,0">
                <TextBlock Text="Заказы с этим товаром" Foreground="#00FF88" FontSize="14" FontWeight="Bold"
                           Margin="0,0,0,8"/>

                <DataGrid x:Name="dgOrders"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Background="#252A33"
                          Foreground="#FFFFFF"
                          RowBackground="#252A33"
                          AlternatingRowBackground="#2F3540"
                          BorderBrush="#2F3540"
                          BorderThickness="1"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#1A1D23"
                          HeadersVisibility="Column"
                          FontSize="12"
                          RowHeight="28"
                          MaxHeight="200">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1A1D23"/>
                            <Setter Property="Foreground" Value="#00FF88"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="8,6"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№ заказа" Binding="{Binding OrderNumber}" Width="130"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat={}{0:N2} ₽}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="txtNoOrders"
                           Text="Заказов с этим товаром нет."
                           Foreground="#A0A8B8"
                           FontSize="12"
                           Margin="0,8,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>

            <Grid Grid.Row="9" Margin="0,25,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="btnEdit"
                        Content="РЕДАКТИРОВАТЬ"
                        Height="45"
                        FontSize="14" FontWeight="Bold"
                        Foreground="#1A1D23"
                        Background="#00FF88"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="btnEdit_Click"/>

                <Button Grid.Column="2"
                        x:Name="btnClose"
                        Content="ЗАКРЫТЬ"
                        Height="45"
                        FontSize="14" FontWeight="Bold"
                        Foreground="#A0A8B8"
                        Background="Transparent"
                        BorderBrush="#2F3540"
                        BorderThickness="2"
                        Cursor="Hand"
                        Click="btnClose_Click"/>
            </Grid>

            <TextBlock Grid.Row="10"
                       x:Name="txtMessage"
                       Foreground="#A0A8B8"
                       FontSize="12"
                       Margin="0,15,0,0"/>
        </Grid>
    </ScrollViewer>
</Window>