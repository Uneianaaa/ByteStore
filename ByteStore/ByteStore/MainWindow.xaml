<Window x:Class="ByteStore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ByteStore — Вход"
        Height="500" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1A1D23"
        FontFamily="Segoe UI">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="ByteStore"
                   FontSize="38"
                   FontWeight="Bold"
                   Foreground="#00FF88"
                   HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="1"
                   Text="Вход в систему"
                   FontSize="16"
                   Foreground="#A0A8B8"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,30"/>

        <StackPanel Grid.Row="2"
                    VerticalAlignment="Center">

            <TextBlock Text="Email"
                       Foreground="#A0A8B8"
                       FontSize="13"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="txtEmail"
                     Height="40"
                     FontSize="14"
                     Padding="10,0"
                     Foreground="#FFFFFF"
                     Background="#252A33"
                     BorderBrush="#2F3540"
                     BorderThickness="1"
                     CaretBrush="#00FF88"
                     Margin="0,0,0,20">
                <TextBox.Resources>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background" Value="#252A33"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <TextBlock Text="Пароль"
                       Foreground="#A0A8B8"
                       FontSize="13"
                       Margin="0,0,0,5"/>

            <PasswordBox x:Name="txtPassword"
                         Height="40"
                         FontSize="14"
                         Padding="10,0"
                         Foreground="#FFFFFF"
                         Background="#252A33"
                         BorderBrush="#2F3540"
                         BorderThickness="1"
                         CaretBrush="#00FF88"/>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,30,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="btnLogin"
                    Content="ВОЙТИ"
                    Height="45"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="#1A1D23"
                    Background="#00FF88"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,5,0"
                    Click="btnLogin_Click"/>

            <Button Grid.Column="1"
                    x:Name="btnRegister"
                    Content="РЕГИСТРАЦИЯ"
                    Height="45"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="#00FF88"
                    Background="Transparent"
                    BorderBrush="#00FF88"
                    BorderThickness="2"
                    Cursor="Hand"
                    Margin="5,0,0,0"
                    Click="btnRegister_Click"/>
        </Grid>

        <TextBlock Grid.Row="4"
                   x:Name="txtMessage"
                   Foreground="#FF4A6E"
                   FontSize="13"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,15,0,0"/>

    </Grid>
</Window>