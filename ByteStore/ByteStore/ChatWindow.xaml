<Window x:Class="ByteStore.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ByteStore — Чат"
        Height="650" Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="#1A1D23"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#252A33"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#00FF88"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#252A33"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Чат"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#00FF88"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    x:Name="btnClose"
                    Content="ЗАКРЫТЬ"
                    Width="100" Height="30"
                    FontSize="12" FontWeight="Bold"
                    Foreground="#FF4A6E"
                    Background="Transparent"
                    BorderBrush="#FF4A6E"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="btnClose_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ КОЛОНКА -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Новый диалог:"
                           Foreground="#A0A8B8"
                           FontSize="13"
                           Margin="0,0,0,8"/>

                <ComboBox Grid.Row="1"
                          x:Name="cmbUsers"
                          SelectionChanged="cmbUsers_SelectionChanged"/>

                <TextBlock Grid.Row="2"
                           Text="Диалоги:"
                           Foreground="#A0A8B8"
                           FontSize="13"
                           Margin="0,20,0,8"/>

                <ListBox Grid.Row="3"
                         x:Name="lstDialogs"
                         Background="#252A33"
                         Foreground="#FFFFFF"
                         BorderBrush="#2F3540"
                         BorderThickness="1"
                         FontSize="13"
                         SelectionChanged="lstDialogs_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10"
                                    Margin="0,2"
                                    Background="Transparent">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding FullName}"
                                                   FontWeight="Bold"
                                                   Foreground="#00FF88"
                                                   FontSize="13"/>
                                        <Border Grid.Column="1"
                                                Background="#FF4A6E"
                                                CornerRadius="10"
                                                Padding="6,2"
                                                Visibility="{Binding UnreadVisibility}">
                                            <TextBlock Text="{Binding UnreadCount}"
                                                       Foreground="#FFFFFF"
                                                       FontSize="11"
                                                       FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding LastMessage}"
                                               Foreground="#A0A8B8"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           x:Name="txtChatWith"
                           Foreground="#00FF88"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,0,0,10"
                           Text="Выберите диалог"/>

                <ListBox Grid.Row="1"
                         x:Name="lstMessages"
                         Background="#252A33"
                         Foreground="#FFFFFF"
                         BorderBrush="#2F3540"
                         BorderThickness="1"
                         FontSize="13"
                         Padding="10"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,5"
                                    Padding="10"
                                    CornerRadius="8"
                                    MaxWidth="450"
                                    HorizontalAlignment="{Binding Align}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#2F3540"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                <Setter Property="Background" Value="#00B85F"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding SenderName}"
                                               FontSize="11"
                                               Foreground="#A0A8B8"
                                               Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               Foreground="#FFFFFF"/>
                                    <TextBlock Text="{Binding SentAt, StringFormat={}{0:HH:mm dd.MM}}"
                                               FontSize="10"
                                               Foreground="#CCCCCC"
                                               HorizontalAlignment="Right"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             x:Name="txtMessage"
                             Height="40"
                             FontSize="13"
                             Padding="10,0"
                             Foreground="#FFFFFF"
                             Background="#252A33"
                             BorderBrush="#2F3540"
                             BorderThickness="1"
                             CaretBrush="#00FF88"
                             VerticalContentAlignment="Center"
                             KeyDown="txtMessage_KeyDown"/>

                    <Button Grid.Column="2"
                            x:Name="btnSend"
                            Content="ОТПРАВИТЬ"
                            Width="130" Height="40"
                            FontSize="13" FontWeight="Bold"
                            Foreground="#1A1D23"
                            Background="#00FF88"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="btnSend_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>