<Window x:Class="ByteStore.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ByteStore — Профиль"
        Height="686" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1A1D23"
        FontFamily="Segoe UI">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Профиль"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#00FF88"
                   Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Ellipse Grid.Column="0"
                     Width="120" Height="120"
                     Stroke="#00FF88"
                     StrokeThickness="2"
                     Margin="0,0,20,0">
                <Ellipse.Fill>
                    <ImageBrush x:Name="imgBrush" Stretch="UniformToFill"/>
                </Ellipse.Fill>
            </Ellipse>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">

                <TextBlock x:Name="txtFullName"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           TextWrapping="Wrap"/>

                <TextBlock x:Name="txtEmail"
                           FontSize="14"
                           Foreground="#A0A8B8"
                           Margin="0,5,0,0"/>

                <Button x:Name="btnUploadPhoto"
                        Content="ЗАГРУЗИТЬ ФОТО"
                        Width="160" Height="32"
                        FontSize="11" FontWeight="Bold"
                        Foreground="#00FF88"
                        Background="Transparent"
                        BorderBrush="#00FF88"
                        BorderThickness="2"
                        Cursor="Hand"
                        HorizontalAlignment="Left"
                        Margin="0,15,0,0"
                        Click="btnUploadPhoto_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Height="1"
                Background="#2F3540"
                Margin="0,25,0,20"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="Фамилия" Foreground="#A0A8B8" FontSize="12" Margin="0,0,0,5"/>
                <TextBox x:Name="txtLastName"
                         Height="35" FontSize="14" Padding="10,0"
                         Foreground="#FFFFFF" Background="#252A33"
                         BorderBrush="#2F3540" BorderThickness="1"
                         CaretBrush="#00FF88" Margin="0,0,0,12"/>

                <TextBlock Text="Имя" Foreground="#A0A8B8" FontSize="12" Margin="0,0,0,5"/>
                <TextBox x:Name="txtFirstName"
                         Height="35" FontSize="14" Padding="10,0"
                         Foreground="#FFFFFF" Background="#252A33"
                         BorderBrush="#2F3540" BorderThickness="1"
                         CaretBrush="#00FF88" Margin="0,0,0,12"/>

                <TextBlock Text="Отчество" Foreground="#A0A8B8" FontSize="12" Margin="0,0,0,5"/>
                <TextBox x:Name="txtMiddleName"
                         Height="35" FontSize="14" Padding="10,0"
                         Foreground="#FFFFFF" Background="#252A33"
                         BorderBrush="#2F3540" BorderThickness="1"
                         CaretBrush="#00FF88" Margin="0,0,0,12"/>
            </StackPanel>

            <StackPanel Grid.Column="2">

                <TextBlock Text="Телефон" Foreground="#A0A8B8" FontSize="12" Margin="0,0,0,5"/>
                <TextBox x:Name="txtPhone"
                         Height="35" FontSize="14" Padding="10,0"
                         Foreground="#FFFFFF" Background="#252A33"
                         BorderBrush="#2F3540" BorderThickness="1"
                         CaretBrush="#00FF88" Margin="0,0,0,12"/>

                <TextBlock Text="Адрес" Foreground="#A0A8B8" FontSize="12" Margin="0,0,0,5"/>
                <TextBox x:Name="txtAddress"
                         Height="35" FontSize="14" Padding="10,0"
                         Foreground="#FFFFFF" Background="#252A33"
                         BorderBrush="#2F3540" BorderThickness="1"
                         CaretBrush="#00FF88" Margin="0,0,0,12"/>
            </StackPanel>
        </Grid>

        <Button Grid.Row="4"
                x:Name="btnSave"
                Content="СОХРАНИТЬ"
                Height="45"
                FontSize="14" FontWeight="Bold"
                Foreground="#1A1D23"
                Background="#00FF88"
                BorderThickness="0"
                Cursor="Hand"
                Margin="0,15,0,0"
                Click="btnSave_Click"/>

        <Border Grid.Row="5"
                Height="1"
                Background="#2F3540"
                Margin="0,25,0,20"/>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="btnChangePassword"
                    Content="СМЕНИТЬ ПАРОЛЬ"
                    Height="40"
                    FontSize="12" FontWeight="Bold"
                    Foreground="#00FF88"
                    Background="Transparent"
                    BorderBrush="#00FF88"
                    BorderThickness="2"
                    Cursor="Hand"
                    Click="btnChangePassword_Click"/>

            <Button Grid.Column="2"
                    x:Name="btnChangeEmail"
                    Content="СМЕНИТЬ EMAIL"
                    Height="40"
                    FontSize="12" FontWeight="Bold"
                    Foreground="#00FF88"
                    Background="Transparent"
                    BorderBrush="#00FF88"
                    BorderThickness="2"
                    Cursor="Hand"
                    Click="btnChangeEmail_Click"/>
        </Grid>

        <TextBlock Grid.Row="7"
                   x:Name="txtMessage"
                   Foreground="#A0A8B8"
                   FontSize="12"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,15,0,0"/>
    </Grid>
</Window>