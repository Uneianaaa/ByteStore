<Window x:Class="ByteStore.CategoriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ByteStore — Категории"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1A1D23"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Категории"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#00FF88"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                       x:Name="txtUserInfo"
                       Foreground="#A0A8B8"
                       FontSize="13"
                       VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,20,0,15">

            <Button x:Name="btnRefresh"
                    Content="ОБНОВИТЬ"
                    Width="120" Height="35"
                    FontSize="12" FontWeight="Bold"
                    Foreground="#00FF88"
                    Background="Transparent"
                    BorderBrush="#00FF88"
                    BorderThickness="2"
                    Cursor="Hand"
                    Margin="0,0,10,0"
                    Click="btnRefresh_Click"/>

            <Button x:Name="btnAdd"
                    Content="ДОБАВИТЬ"
                    Width="120" Height="35"
                    FontSize="12" FontWeight="Bold"
                    Foreground="#1A1D23"
                    Background="#00FF88"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,10,0"
                    Click="btnAdd_Click"/>

            <Button x:Name="btnEdit"
                    Content="РЕДАКТИРОВАТЬ"
                    Width="140" Height="35"
                    FontSize="12" FontWeight="Bold"
                    Foreground="#00FF88"
                    Background="Transparent"
                    BorderBrush="#00FF88"
                    BorderThickness="2"
                    Cursor="Hand"
                    Margin="0,0,10,0"
                    Click="btnEdit_Click"/>

            <Button x:Name="btnDelete"
                    Content="УДАЛИТЬ"
                    Width="120" Height="35"
                    FontSize="12" FontWeight="Bold"
                    Foreground="#FF4A6E"
                    Background="Transparent"
                    BorderBrush="#FF4A6E"
                    BorderThickness="2"
                    Cursor="Hand"
                    Click="btnDelete_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="2"
                  x:Name="dgCategories"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Background="#252A33"
                  Foreground="#FFFFFF"
                  RowBackground="#252A33"
                  AlternatingRowBackground="#2F3540"
                  BorderBrush="#2F3540"
                  BorderThickness="1"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#1A1D23"
                  HeadersVisibility="Column"
                  FontSize="13"
                  RowHeight="30">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#1A1D23"/>
                    <Setter Property="Foreground" Value="#00FF88"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10,8"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"          Binding="{Binding Id}"          Width="60"/>
                <DataGridTextColumn Header="Название"    Binding="{Binding Name}"        Width="200"/>
                <DataGridTextColumn Header="Описание"    Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3"
                   x:Name="txtMessage"
                   Foreground="#A0A8B8"
                   FontSize="12"
                   Margin="0,10,0,0"/>

        <Button Grid.Row="4"
                x:Name="btnBack"
                Content="НАЗАД"
                Width="150" Height="40"
                FontSize="13" FontWeight="Bold"
                Foreground="#A0A8B8"
                Background="Transparent"
                BorderBrush="#2F3540"
                BorderThickness="2"
                Cursor="Hand"
                HorizontalAlignment="Left"
                Margin="0,15,0,0"
                Click="btnBack_Click"/>
    </Grid>
</Window>