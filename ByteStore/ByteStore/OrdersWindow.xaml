<Window x:Class="ByteStore.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ByteStore — Заказы"
        Height="650" Width="1150"
        WindowStartupLocation="CenterScreen"
        Background="#1A1D23"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A8B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#2F3540"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00FF88"/>
                                <Setter Property="Foreground" Value="#00FF88"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#00FF88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Заказы"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#00FF88"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                       x:Name="txtUserInfo"
                       Foreground="#A0A8B8"
                       FontSize="13"
                       VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,20,0,15">

            <Button x:Name="btnRefresh"
                    Content="ОБНОВИТЬ"
                    Width="120" Height="35"
                    FontSize="12" FontWeight="Bold"
                    Foreground="#00FF88"
                    Background="Transparent"
                    BorderBrush="#00FF88"
                    BorderThickness="2"
                    Cursor="Hand"
                    Margin="0,0,10,0"
                    Click="btnRefresh_Click"/>

            <Button x:Name="btnChangeStatus"
                    Content="СМЕНИТЬ СТАТУС"
                    Width="150" Height="35"
                    FontSize="12" FontWeight="Bold"
                    Foreground="#1A1D23"
                    Background="#00FF88"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,10,0"
                    Click="btnChangeStatus_Click"/>

            <Button x:Name="btnDetails"
                    Content="ПОДРОБНЕЕ"
                    Width="130" Height="35"
                    FontSize="12" FontWeight="Bold"
                    Foreground="#00FF88"
                    Background="Transparent"
                    BorderBrush="#00FF88"
                    BorderThickness="2"
                    Cursor="Hand"
                    Margin="0,0,10,0"
                    Click="btnDetails_Click"/>

            <Button x:Name="btnDelete"
                    Content="УДАЛИТЬ"
                    Width="120" Height="35"
                    FontSize="12" FontWeight="Bold"
                    Foreground="#FF4A6E"
                    Background="Transparent"
                    BorderBrush="#FF4A6E"
                    BorderThickness="2"
                    Cursor="Hand"
                    Click="btnDelete_Click"/>
        </StackPanel>

        <TabControl Grid.Row="2"
                    x:Name="tabControl"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectionChanged="tabControl_SelectionChanged">

            <TabItem Header="ВСЕ">
                <DataGrid x:Name="dgAll"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Background="#252A33"
                          Foreground="#FFFFFF"
                          RowBackground="#252A33"
                          AlternatingRowBackground="#2F3540"
                          BorderBrush="#2F3540"
                          BorderThickness="1"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#1A1D23"
                          HeadersVisibility="Column"
                          FontSize="12"
                          RowHeight="30"
                          MouseDoubleClick="dg_MouseDoubleClick">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1A1D23"/>
                            <Setter Property="Foreground" Value="#00FF88"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="8,8"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"          Binding="{Binding Id}"           Width="50"/>
                        <DataGridTextColumn Header="№ заказа"    Binding="{Binding OrderNumber}"  Width="130"/>
                        <DataGridTextColumn Header="Дата"        Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="120"/>
                        <DataGridTextColumn Header="Покупатель"  Binding="{Binding CustomerName}" Width="180"/>
                        <DataGridTextColumn Header="Продавец"    Binding="{Binding SellerName}"   Width="180"/>
                        <DataGridTextColumn Header="Сумма"       Binding="{Binding TotalAmount, StringFormat={}{0:N2} ₽}" Width="110"/>
                        <DataGridTextColumn Header="Статус"      Binding="{Binding Status}"       Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="НОВЫЕ">
                <DataGrid x:Name="dgNew"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Background="#252A33"
                          Foreground="#FFFFFF"
                          RowBackground="#252A33"
                          AlternatingRowBackground="#2F3540"
                          BorderBrush="#2F3540"
                          BorderThickness="1"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#1A1D23"
                          HeadersVisibility="Column"
                          FontSize="12"
                          RowHeight="30"
                          MouseDoubleClick="dg_MouseDoubleClick">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1A1D23"/>
                            <Setter Property="Foreground" Value="#00FF88"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="8,8"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"          Binding="{Binding Id}"           Width="50"/>
                        <DataGridTextColumn Header="№ заказа"    Binding="{Binding OrderNumber}"  Width="130"/>
                        <DataGridTextColumn Header="Дата"        Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="120"/>
                        <DataGridTextColumn Header="Покупатель"  Binding="{Binding CustomerName}" Width="180"/>
                        <DataGridTextColumn Header="Продавец"    Binding="{Binding SellerName}"   Width="180"/>
                        <DataGridTextColumn Header="Сумма"       Binding="{Binding TotalAmount, StringFormat={}{0:N2} ₽}" Width="110"/>
                        <DataGridTextColumn Header="Статус"      Binding="{Binding Status}"       Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="ОПЛАЧЕННЫЕ">
                <DataGrid x:Name="dgPaid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Background="#252A33"
                          Foreground="#FFFFFF"
                          RowBackground="#252A33"
                          AlternatingRowBackground="#2F3540"
                          BorderBrush="#2F3540"
                          BorderThickness="1"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#1A1D23"
                          HeadersVisibility="Column"
                          FontSize="12"
                          RowHeight="30"
                          MouseDoubleClick="dg_MouseDoubleClick">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1A1D23"/>
                            <Setter Property="Foreground" Value="#00FF88"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="8,8"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"          Binding="{Binding Id}"           Width="50"/>
                        <DataGridTextColumn Header="№ заказа"    Binding="{Binding OrderNumber}"  Width="130"/>
                        <DataGridTextColumn Header="Дата"        Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="120"/>
                        <DataGridTextColumn Header="Покупатель"  Binding="{Binding CustomerName}" Width="180"/>
                        <DataGridTextColumn Header="Продавец"    Binding="{Binding SellerName}"   Width="180"/>
                        <DataGridTextColumn Header="Сумма"       Binding="{Binding TotalAmount, StringFormat={}{0:N2} ₽}" Width="110"/>
                        <DataGridTextColumn Header="Статус"      Binding="{Binding Status}"       Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="ОТПРАВЛЕННЫЕ">
                <DataGrid x:Name="dgShipped"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Background="#252A33"
                          Foreground="#FFFFFF"
                          RowBackground="#252A33"
                          AlternatingRowBackground="#2F3540"
                          BorderBrush="#2F3540"
                          BorderThickness="1"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#1A1D23"
                          HeadersVisibility="Column"
                          FontSize="12"
                          RowHeight="30"
                          MouseDoubleClick="dg_MouseDoubleClick">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1A1D23"/>
                            <Setter Property="Foreground" Value="#00FF88"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="8,8"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"          Binding="{Binding Id}"           Width="50"/>
                        <DataGridTextColumn Header="№ заказа"    Binding="{Binding OrderNumber}"  Width="130"/>
                        <DataGridTextColumn Header="Дата"        Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="120"/>
                        <DataGridTextColumn Header="Покупатель"  Binding="{Binding CustomerName}" Width="180"/>
                        <DataGridTextColumn Header="Продавец"    Binding="{Binding SellerName}"   Width="180"/>
                        <DataGridTextColumn Header="Сумма"       Binding="{Binding TotalAmount, StringFormat={}{0:N2} ₽}" Width="110"/>
                        <DataGridTextColumn Header="Статус"      Binding="{Binding Status}"       Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="ЗАВЕРШЁННЫЕ">
                <DataGrid x:Name="dgCompleted"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Background="#252A33"
                          Foreground="#FFFFFF"
                          RowBackground="#252A33"
                          AlternatingRowBackground="#2F3540"
                          BorderBrush="#2F3540"
                          BorderThickness="1"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#1A1D23"
                          HeadersVisibility="Column"
                          FontSize="12"
                          RowHeight="30"
                          MouseDoubleClick="dg_MouseDoubleClick">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1A1D23"/>
                            <Setter Property="Foreground" Value="#00FF88"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="8,8"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"          Binding="{Binding Id}"           Width="50"/>
                        <DataGridTextColumn Header="№ заказа"    Binding="{Binding OrderNumber}"  Width="130"/>
                        <DataGridTextColumn Header="Дата"        Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="120"/>
                        <DataGridTextColumn Header="Покупатель"  Binding="{Binding CustomerName}" Width="180"/>
                        <DataGridTextColumn Header="Продавец"    Binding="{Binding SellerName}"   Width="180"/>
                        <DataGridTextColumn Header="Сумма"       Binding="{Binding TotalAmount, StringFormat={}{0:N2} ₽}" Width="110"/>
                        <DataGridTextColumn Header="Статус"      Binding="{Binding Status}"       Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="ОТМЕНЁННЫЕ">
                <DataGrid x:Name="dgCancelled"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Background="#252A33"
                          Foreground="#FFFFFF"
                          RowBackground="#252A33"
                          AlternatingRowBackground="#2F3540"
                          BorderBrush="#2F3540"
                          BorderThickness="1"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#1A1D23"
                          HeadersVisibility="Column"
                          FontSize="12"
                          RowHeight="30"
                          MouseDoubleClick="dg_MouseDoubleClick">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1A1D23"/>
                            <Setter Property="Foreground" Value="#00FF88"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="8,8"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"          Binding="{Binding Id}"           Width="50"/>
                        <DataGridTextColumn Header="№ заказа"    Binding="{Binding OrderNumber}"  Width="130"/>
                        <DataGridTextColumn Header="Дата"        Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="120"/>
                        <DataGridTextColumn Header="Покупатель"  Binding="{Binding CustomerName}" Width="180"/>
                        <DataGridTextColumn Header="Продавец"    Binding="{Binding SellerName}"   Width="180"/>
                        <DataGridTextColumn Header="Сумма"       Binding="{Binding TotalAmount, StringFormat={}{0:N2} ₽}" Width="110"/>
                        <DataGridTextColumn Header="Статус"      Binding="{Binding Status}"       Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="3"
                   x:Name="txtMessage"
                   Foreground="#A0A8B8"
                   FontSize="12"
                   Margin="0,10,0,0"/>

        <Button Grid.Row="4"
                x:Name="btnBack"
                Content="НАЗАД"
                Width="150" Height="40"
                FontSize="13" FontWeight="Bold"
                Foreground="#A0A8B8"
                Background="Transparent"
                BorderBrush="#2F3540"
                BorderThickness="2"
                Cursor="Hand"
                HorizontalAlignment="Left"
                Margin="0,15,0,0"
                Click="btnBack_Click"/>
    </Grid>
</Window>