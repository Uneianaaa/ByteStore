<Window x:Class="ByteStore.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ByteStore — Регистрация"
        Height="507" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1A1D23"
        FontFamily="Segoe UI">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="ByteStore"
                   FontSize="32"
                   FontWeight="Bold"
                   Foreground="#00FF88"
                   HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="1"
                   Text="Регистрация"
                   FontSize="16"
                   Foreground="#A0A8B8"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="Email" Foreground="#A0A8B8" FontSize="12" Margin="0,0,0,5"/>
                <TextBox x:Name="txtEmail"
                         Height="35" FontSize="14" Padding="10,0"
                         Foreground="#FFFFFF" Background="#252A33"
                         BorderBrush="#2F3540" BorderThickness="1"
                         CaretBrush="#00FF88" Margin="0,0,0,12"/>

                <TextBlock Text="Пароль" Foreground="#A0A8B8" FontSize="12" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtPassword"
                             Height="35" FontSize="14" Padding="10,0"
                             Foreground="#FFFFFF" Background="#252A33"
                             BorderBrush="#2F3540" BorderThickness="1"
                             CaretBrush="#00FF88" Margin="0,0,0,12"/>

                <TextBlock Text="Отчество (необязательно)" Foreground="#A0A8B8" FontSize="12" Margin="0,0,0,5"/>
                <TextBox x:Name="txtMiddleName"
                         Height="35" FontSize="14" Padding="10,0"
                         Foreground="#FFFFFF" Background="#252A33"
                         BorderBrush="#2F3540" BorderThickness="1"
                         CaretBrush="#00FF88" Margin="0,0,0,12"/>
            </StackPanel>

            <StackPanel Grid.Column="2">

                <TextBlock Text="Фамилия" Foreground="#A0A8B8" FontSize="12" Margin="0,0,0,5"/>
                <TextBox x:Name="txtLastName"
                         Height="35" FontSize="14" Padding="10,0"
                         Foreground="#FFFFFF" Background="#252A33"
                         BorderBrush="#2F3540" BorderThickness="1"
                         CaretBrush="#00FF88" Margin="0,0,0,12"/>

                <TextBlock Text="Имя" Foreground="#A0A8B8" FontSize="12" Margin="0,0,0,5"/>
                <TextBox x:Name="txtFirstName"
                         Height="35" FontSize="14" Padding="10,0"
                         Foreground="#FFFFFF" Background="#252A33"
                         BorderBrush="#2F3540" BorderThickness="1"
                         CaretBrush="#00FF88" Margin="0,0,0,12"/>

                <TextBlock Text="Код из письма" Foreground="#A0A8B8" FontSize="12" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             x:Name="txtCode"
                             Height="35" FontSize="14" Padding="10,0"
                             Foreground="#FFFFFF" Background="#252A33"
                             BorderBrush="#2F3540" BorderThickness="1"
                             CaretBrush="#00FF88"
                             IsEnabled="False"
                             Margin="0,0,8,0"/>

                    <Button Grid.Column="1"
                            x:Name="btnGetCode"
                            Content="ПОЛУЧИТЬ"
                            Width="100" Height="35"
                            FontSize="12" FontWeight="Bold"
                            Foreground="#1A1D23" Background="#00FF88"
                            BorderThickness="0" Cursor="Hand"
                            Click="btnGetCode_Click"/>
                </Grid>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,25,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="btnBack"
                    Content="НАЗАД"
                    Height="45" FontSize="14" FontWeight="Bold"
                    Foreground="#A0A8B8" Background="Transparent"
                    BorderBrush="#2F3540" BorderThickness="2"
                    Cursor="Hand"
                    Click="btnBack_Click"/>

            <Button Grid.Column="2"
                    x:Name="btnRegister"
                    Content="ЗАРЕГИСТРИРОВАТЬСЯ"
                    Height="45" FontSize="14" FontWeight="Bold"
                    Foreground="#1A1D23" Background="#00FF88"
                    BorderThickness="0" Cursor="Hand"
                    Click="btnRegister_Click"/>
        </Grid>

        <TextBlock Grid.Row="4"
                   x:Name="txtMessage"
                   Foreground="#FF4A6E"
                   FontSize="13"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,15,0,0"/>
    </Grid>
</Window>