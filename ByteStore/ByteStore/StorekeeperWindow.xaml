<Window x:Class="ByteStore.StorekeeperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ByteStore — Панель кладовщика"
        Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#1A1D23"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,20,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Панель кладовщика"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#00FF88"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock x:Name="txtUserInfo"
                           Foreground="#00FF88"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Cursor="Hand"
                           TextDecorations="Underline"
                           Margin="0,0,15,0"
                           MouseLeftButtonUp="txtUserInfo_MouseLeftButtonUp"
                           ToolTip="Открыть профиль"/>

                <Button x:Name="btnChat"
                        Content="ЧАТ"
                        Width="80" Height="30"
                        FontSize="12" FontWeight="Bold"
                        Foreground="#00FF88"
                        Background="Transparent"
                        BorderBrush="#00FF88"
                        BorderThickness="1"
                        Cursor="Hand"
                        Margin="0,0,10,0"
                        Click="btnChat_Click"/>

                <Button x:Name="btnLogout"
                        Content="ВЫЙТИ"
                        Width="80" Height="30"
                        FontSize="12" FontWeight="Bold"
                        Foreground="#FF4A6E"
                        Background="Transparent"
                        BorderBrush="#FF4A6E"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="btnLogout_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="20,20,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <Button x:Name="btnProducts"
                        Content="ТОВАРЫ"
                        Height="45"
                        FontSize="13" FontWeight="Bold"
                        Foreground="#00FF88"
                        Background="Transparent"
                        BorderBrush="#00FF88"
                        BorderThickness="2"
                        Cursor="Hand"
                        Margin="0,0,0,10"
                        Click="btnProducts_Click"/>

                <Button x:Name="btnReports"
                        Content="ОТЧЁТЫ"
                        Height="45"
                        FontSize="13" FontWeight="Bold"
                        Foreground="#00FF88"
                        Background="Transparent"
                        BorderBrush="#00FF88"
                        BorderThickness="2"
                        Cursor="Hand"
                        Margin="0,0,0,10"
                        Click="btnReports_Click"/>
            </StackPanel>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Обзор склада"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           Margin="0,0,0,20"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0"
                            Background="#252A33" CornerRadius="10" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Видов товаров" Foreground="#A0A8B8" FontSize="13"/>
                            <TextBlock x:Name="txtTotalProducts" Text="—"
                                       Foreground="#00FF88" FontSize="32" FontWeight="Bold"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="2"
                            Background="#252A33" CornerRadius="10" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Товаров на исходе" Foreground="#A0A8B8" FontSize="13"/>
                            <TextBlock x:Name="txtLowStock" Text="—"
                                       Foreground="#FF4A6E" FontSize="32" FontWeight="Bold"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0"
                            Background="#252A33" CornerRadius="10" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Единиц на складе" Foreground="#A0A8B8" FontSize="13"/>
                            <TextBlock x:Name="txtTotalUnits" Text="—"
                                       Foreground="#00FF88" FontSize="32" FontWeight="Bold"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="2"
                            Background="#252A33" CornerRadius="10" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Общая стоимость склада" Foreground="#A0A8B8" FontSize="13"/>
                            <TextBlock x:Name="txtStockValue" Text="—"
                                       Foreground="#00FF88" FontSize="22" FontWeight="Bold"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="2"
                           x:Name="txtMessage"
                           Foreground="#A0A8B8"
                           FontSize="12"
                           Margin="0,20,0,0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>